# Fraud Detection & IP Risk Analysis Dashboard - Environment Configuration

# Flask Application
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=cyber_security_secret_key_change_in_production_2026

# MySQL Database Configuration
# If MySQL is not running, the application will automatically fall back to SQLite
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fraud_detection_db
DB_USER=root
DB_PASSWORD=

# SQLite Database Fallback Path
SQLITE_DB_PATH=database/fraud_detection.db

# IP Intelligence API Keys (Leave blank to enable high-fidelity intelligent simulation mode)
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=

# Bank API / Open Banking Configuration (Leave blank for Demo Mode with simulated transactions)
BANK_API_CLIENT_ID=
BANK_API_SECRET=
BANK_API_ENV=sandbox

# Simulation Mode: set to 'true' to force simulation even if keys exist
SIMULATION_MODE=false
